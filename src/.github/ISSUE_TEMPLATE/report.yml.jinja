name: Report
description: Report a problem
assignees: {{ maintainers | tojson }}
body:
{%- if profile == 'mirror' %}
  - type: input
    id: package
    attributes:
      label: Package
      description: The ocx.sh package, e.g. ocx.sh/age/age
    validations:
      required: true
  - type: input
    id: version
    attributes:
      label: Version
      description: The package version affected
    validations:
      required: true
  - type: dropdown
    id: platform
    attributes:
      label: Platform
      options:
        - linux/amd64
        - linux/arm64
        - darwin/amd64
        - darwin/arm64
        - windows/amd64
        - windows/arm64
    validations:
      required: true
  - type: textarea
    id: what-happened
    attributes:
      label: What happened
      description: What you ran, what you expected, what you got
    validations:
      required: true
{%- else %}
  - type: textarea
    id: summary
    attributes:
      label: Summary
    validations:
      required: true
  - type: textarea
    id: steps
    attributes:
      label: Steps to reproduce
    validations:
      required: true
  - type: textarea
    id: expected
    attributes:
      label: Expected behavior
    validations:
      required: true
  - type: textarea
    id: actual
    attributes:
      label: Actual behavior
    validations:
      required: true
{%- endif %}
