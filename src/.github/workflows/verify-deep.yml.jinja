{%- set ver = ((_copier_conf.vcs_ref or '') | regex_search('^v\\d[\\w.]*(?:-[\\w.]+)?$')) or 'v0' -%}
{%- set setup = 'ocx-sh/conventions/.github/actions/setup@' ~ _copier_conf.vcs_ref_hash ~ ' # ' ~ ver -%}
{%- set has_bazel = bazel -%}
{%- set trusted = bazel and bazel_cache_write == 'trusted' -%}
{%- set has_repo = repo_workflows -%}
{%- set repo_secrets = repo_workflows.secrets if has_repo else [] -%}
{#- Every secret this file reads must be declared under workflow_call: actionlint (and GitHub) treat the block as the whole `secrets` object. -#}
{%- set cache_secrets = ['BAZEL_CACHE_WRITE_AUTH'] if trusted else (['BAZEL_CACHE_READ_AUTH'] if has_bazel else []) -%}
{%- set called_secrets = (['OTEL_OTLP_AUTH'] + cache_secrets + repo_secrets) | unique | list -%}
name: verify-deep

on:
  schedule:
    # Nightly minute is stable per repository: sha256(repo_name)[:4] % 60, computed at render time.
    - cron: "{{ (repo_name | hash('sha256'))[:4] | int(base=16) % 60 }} 3 * * *"
  workflow_dispatch:
  # A caller passes the secrets this file reads by name (never `secrets: inherit`); all optional, so an empty one degrades.
  workflow_call:
    secrets:
{%- for s in called_secrets %}
      {{ s }}:
        required: false
{%- endfor %}
  # Lets a PR that adds this workflow run its own deep tier (dispatch needs the file on the default branch).
  pull_request:
    types: [labeled]

permissions: {}

jobs:
  deep:
    if: {% raw %}github.event_name != 'pull_request' || github.event.label.name == 'run-deep'{% endraw %}
    name: deep ({% raw %}${{ matrix.os }}{% endraw %})
    runs-on: {% raw %}${{ matrix.os }}{% endraw %}
    permissions:
      contents: read
    strategy:
      fail-fast: false
      matrix:
        os: [{{ deep_os | join(', ') }}]
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
          submodules: recursive
      - uses: {{ setup }}
        with:
          groups: default,test{% if has_bazel %},build{% endif %}
{%- if trusted %}
          bazel-cache: trusted
          cache-write-auth: {% raw %}${{ secrets.BAZEL_CACHE_WRITE_AUTH }}{% endraw %}
{%- elif has_bazel %}
          bazel-cache: read
          cache-read-auth: {% raw %}${{ secrets.BAZEL_CACHE_READ_AUTH }}{% endraw %}
{%- endif %}
          otel-auth: {% raw %}${{ secrets.OTEL_OTLP_AUTH }}{% endraw %}
      - run: task ci:deep
      - name: Push JUnit telemetry
        if: always()
        uses: {{ setup }}
        with:
          report: target/reports/junit/*.xml
          otel-auth: {% raw %}${{ secrets.OTEL_OTLP_AUTH }}{% endraw %}
      - name: Upload JUnit reports
        if: always()
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: junit-{% raw %}${{ matrix.os }}{% endraw %}
          path: target/reports/junit
          if-no-files-found: ignore
{%- if has_repo %}

  # Repo-owned deep jobs: .github/workflows/deep-repo.yml is seeded once and belongs to the repo from then on.
  repo:
    if: {% raw %}github.event_name != 'pull_request' || github.event.label.name == 'run-deep'{% endraw %}
    permissions:
      contents: read
    uses: ./.github/workflows/deep-repo.yml
{%- if repo_secrets %}
    secrets:
{%- for s in repo_secrets %}
      {{ s }}: {% raw %}${{ secrets.{% endraw %}{{ s }}{% raw %} }}{% endraw %}
{%- endfor %}
{%- endif %}
{%- endif %}

  # One issue labelled nightly-red: opened/updated on a red scheduled run, closed on the next green one.
  nightly-red:
    if: {% raw %}always() && github.event_name == 'schedule'{% endraw %}
    needs: [deep{% if has_repo %}, repo{% endif %}]
    runs-on: ubuntu-latest
    permissions:
      issues: write
    steps:
      - name: Open, update or close the nightly-red issue
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
          REPO: {% raw %}${{ github.repository }}{% endraw %}
          RESULT: {% raw %}${{ needs.deep.result }}{% endraw %}
{%- if has_repo %}
          REPO_RESULT: {% raw %}${{ needs.repo.result }}{% endraw %}
{%- endif %}
          RUN_URL: {% raw %}${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}{% endraw %}
        run: |
          set -euo pipefail
{%- if has_repo %}
          # A red repo-owned job reddens the night; a cancelled one leaves the issue as it is.
          [ "$REPO_RESULT" = success ] || [ "$RESULT" = failure ] || RESULT=$REPO_RESULT
{%- endif %}
          num=$(gh issue list --repo "$REPO" --label nightly-red --state open --json number --jq '.[0].number // empty')
          if [ "$RESULT" = success ]; then
            [ -z "$num" ] || gh issue close "$num" --repo "$REPO" --comment "Nightly green again: $RUN_URL"
          elif [ "$RESULT" = failure ]; then
            if [ -n "$num" ]; then
              gh issue comment "$num" --repo "$REPO" --body "Still red: $RUN_URL"
            else
              gh label create nightly-red --repo "$REPO" --color B60205 --description "verify-deep failed on schedule" 2>/dev/null || true
              gh issue create --repo "$REPO" --label nightly-red --title "verify-deep: nightly red" --body "The scheduled verify-deep run failed: $RUN_URL"
            fi
          fi
