{%- set deploy_path = site.get('path', '') -%}
{%- set deploy_path = deploy_path ~ '/' if deploy_path and not deploy_path.endswith('/') else deploy_path -%}
{%- set ver = ((_copier_conf.vcs_ref or '') | regex_search('^v\\d[\\w.]*(?:-[\\w.]+)?$')) or 'v0' -%}
name: Deploy to ocx.sh

# Publishes the site on push to main that touches the site, plus a manual dispatch. No pull_request trigger: PR
# previews stay as they are, and the `ocx.sh` environment admits main only.
on:
  push:
    branches: [main]
    paths:
      - "{{ site.dir }}/**"
      - ocx.toml
      - ocx.lock
{%- for p in site.get('paths', []) %}
      - "{{ p }}"
{%- endfor %}
  workflow_dispatch:

permissions: {}

jobs:
  deploy:
    name: Deploy
    runs-on: ubuntu-latest
    environment:
      name: ocx.sh
      url: {% raw %}${{ steps.deploy.outputs.url }}{% endraw %}
    concurrency:
      group: deploy-site
      cancel-in-progress: false
    permissions:
      contents: read
    steps:
      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - name: Setup
        uses: ocx-sh/conventions/.github/actions/setup@{{ _copier_conf.vcs_ref_hash }} # {{ ver }}
        with:
          groups: default,docs
      - name: Build the site
        run: task ci:docs
      - name: Deploy
        id: deploy
        uses: ocx-sh/website/.github/actions/deploy@e86b83014538975c186912e5038567c69b2f2f2c # v0.3.0
        with:
          dist: "{{ site.dist }}"
          path: "{{ deploy_path }}"
          storage-key: {% raw %}${{ secrets.BUNNY_STORAGE_KEY }}{% endraw %}
