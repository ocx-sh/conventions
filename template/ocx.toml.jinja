# Seeded once by ocx-sh/conventions; the repo owns it afterwards.
# Every ref is an exact X.Y.Z version (no `latest`); ocx.lock is tracked.
# Groups map to CI roles (D-04): [tools] is `task` only, which every shard needs;
# lint = linters and the grim/uv/copier toolchain, test = runtimes and test tools,
# build = compilers and bazelisk, docs = site tooling, release = git-cliff.
# CI installs `default,<role>`; `ocx exec -- task setup` pulls every group locally.
[tools]
task = "ocx.sh/go-task/task:3.53.1"

[group.lint.tools]
prek = "ocx.sh/prek/prek:0.5.5"
gitleaks = "ocx.sh/gitleaks/gitleaks:8.30.1"
actionlint = "ocx.sh/actionlint/actionlint:1.7.12"
grim = "ocx.sh/grimoire/cli:0.14.3"
uv = "ocx.sh/astral-sh/uv:0.13.0"
{%- if profile == 'full' %}

# Empty on purpose: CI's test job installs `default,test` and ocx rejects an undeclared group.
# The repo adds its runtimes and test tools here (python, node, ...).
[group.test.tools]
{%- endif %}
{%- if profile == 'full' and bazel %}

[group.build.tools]
bazelisk = "ocx.sh/bazelbuild/bazelisk:1.29.0"
{%- endif %}
{%- if profile == 'full' and site %}

[group.docs.tools]
node = "ocx.sh/nodejs/node:24.21.0"
pnpm = "ocx.sh/pnpm/pnpm:11.22.0"
{%- endif %}

[group.release.tools]
git-cliff = "ocx.sh/git-cliff/git-cliff:2.14.2"
