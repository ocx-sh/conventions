{%- set ignored = (zizmor_ignore | default([])) | map('regex_replace', '^.*/', '') | list -%}
# ocx-baseline: template-owned file — change ocx-sh/conventions, then run task copier:update
# zizmor policy for this repo (https://docs.zizmor.sh/configuration/).
rules:
{#- zizmor has no path exclusion, only a per-rule `ignore` list. `audits` is every audit of the pinned ZIZMOR_VERSION
    (baseline.taskfile.yml) not configured below: a version bump that adds an audit must add its id, or a listed workflow
    starts failing. #}
{%- set audits = ['adhoc-packages', 'anonymous-definition', 'archived-uses', 'artipacked', 'bot-conditions', 'cache-poisoning',
    'concurrency-limits', 'dangerous-triggers', 'dependabot-cooldown', 'dependabot-execution', 'excessive-permissions',
    'forbidden-uses', 'github-app', 'github-env', 'hardcoded-container-credentials', 'impostor-commit', 'insecure-commands',
    'insecure-url-scheme', 'known-vulnerable-actions', 'misfeature', 'obfuscation', 'overprovisioned-secrets', 'ref-confusion',
    'ref-version-mismatch', 'secrets-inherit', 'secrets-outside-env', 'self-hosted-runner', 'stale-action-refs',
    'superfluous-actions', 'template-injection', 'typosquat-uses', 'undocumented-permissions', 'unpinned-images',
    'unpinned-tools', 'unredacted-secrets', 'unsound-condition', 'unsound-contains', 'unsound-ternary',
    'use-trusted-publishing'] %}
  unpinned-uses:
    config:
      policies:
        # Default is ref-pin for actions/* and hash-pin for the rest. Our own actions hash-pin too.
        actions/*: hash-pin
        ocx-sh/*: hash-pin
        '*': hash-pin
{%- if ignored %}
    # Workflows generated by another tool (the `zizmor_ignore` answer); hand-written ones are fixed, not listed.
    ignore:
{%- for f in ignored %}
      - {{ f }}
{%- endfor %}
{%- endif %}
  # Flags every `uses: ./.github/actions/deploy`; the deploy contract (C-329) mandates that
  # local path, so the rule has no actionable finding here.
  self-repository:
    disable: true
{%- for id in audits if ignored %}
  {{ id }}:
    ignore:
{%- for f in ignored %}
      - {{ f }}
{%- endfor %}
{%- endfor %}
