{#- ocx-baseline: template-owned file; change ocx-sh/conventions, then run task copier:update -#}
{%- set ver = ((_copier_conf.vcs_ref or '') | regex_search('^v\\d[^\\s]*')) or 'v0' -%}
{%- set setup = 'ocx-sh/conventions/.github/actions/setup@' ~ _copier_conf.vcs_ref_hash ~ ' # ' ~ ver -%}
{%- set has_bazel = bazel -%}
# ocx-baseline: template-owned file — change ocx-sh/conventions, then run task copier:update
name: verify-deep

on:
  schedule:
    # Nightly minute is stable per repository: sha256(repo_name)[:4] % 60, computed at render time.
    - cron: "{{ (repo_name | hash('sha256'))[:4] | int(base=16) % 60 }} 3 * * *"
  workflow_dispatch:
  workflow_call:
  # Lets a PR that adds this workflow run its own deep tier (dispatch needs the file on the default branch).
  pull_request:
    types: [labeled]

permissions: {}

jobs:
  deep:
    if: {% raw %}github.event_name != 'pull_request' || github.event.label.name == 'run-deep'{% endraw %}
    name: deep ({% raw %}${{ matrix.os }}{% endraw %})
    runs-on: {% raw %}${{ matrix.os }}{% endraw %}
    # Reads OTEL{% if has_bazel %} and Bazel cache{% endif %} secrets, so it runs in an environment.
    environment: ci
    permissions:
      contents: read
    strategy:
      fail-fast: false
      matrix:
        os: [{{ deep_os | join(', ') }}]
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: {{ setup }}
        with:
          groups: default,test{% if has_bazel %},build{% endif %}
{%- if has_bazel %}
          bazel-cache: read
          cache-read-auth: {% raw %}${{ secrets.BAZEL_CACHE_READ_AUTH }}{% endraw %}
{%- endif %}
          otel-auth: {% raw %}${{ secrets.OTEL_AUTH }}{% endraw %}
      - run: task ci:deep
      - name: Push JUnit telemetry
        if: always()
        uses: {{ setup }}
        with:
          report: target/reports/junit/*.xml
          otel-auth: {% raw %}${{ secrets.OTEL_AUTH }}{% endraw %}
      - name: Upload JUnit reports
        if: always()
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: junit-{% raw %}${{ matrix.os }}{% endraw %}
          path: target/reports/junit
          if-no-files-found: ignore

  # One issue labelled nightly-red: opened/updated on a red scheduled run, closed on the next green one.
  nightly-red:
    if: {% raw %}always() && github.event_name == 'schedule'{% endraw %}
    needs: [deep]
    runs-on: ubuntu-latest
    permissions:
      issues: write
    steps:
      - name: Open, update or close the nightly-red issue
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
          REPO: {% raw %}${{ github.repository }}{% endraw %}
          RESULT: {% raw %}${{ needs.deep.result }}{% endraw %}
          RUN_URL: {% raw %}${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}{% endraw %}
        run: |
          set -euo pipefail
          num=$(gh issue list --repo "$REPO" --label nightly-red --state open --json number --jq '.[0].number // empty')
          if [ "$RESULT" = success ]; then
            [ -z "$num" ] || gh issue close "$num" --repo "$REPO" --comment "Nightly green again: $RUN_URL"
          elif [ "$RESULT" = failure ]; then
            if [ -n "$num" ]; then
              gh issue comment "$num" --repo "$REPO" --body "Still red: $RUN_URL"
            else
              gh label create nightly-red --repo "$REPO" --color B60205 --description "verify-deep failed on schedule" 2>/dev/null || true
              gh issue create --repo "$REPO" --label nightly-red --title "verify-deep: nightly red" --body "The scheduled verify-deep run failed: $RUN_URL"
            fi
          fi
