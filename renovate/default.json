{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "OCX baseline Renovate preset (default): weekly schedule; chore(deps) commits, ci(deps) for workflow actions."
  ],
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests",
    ":semanticCommits"
  ],
  "timezone": "UTC",
  "minimumReleaseAge": "7 days",
  "schedule": [
    "before 6am on monday"
  ],
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "copier": {
    "enabled": true
  },
  "bazel-module": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": [
        "ocx.toml exact pins \"ocx.sh/<org>/<pkg>:X.Y.Z\"; ocx.sh is an index, so lookups go to the backing ghcr.io repo (ocx-contrib/<org>/<pkg>, except grimoire/cli and ocx/cli). Build-timestamped tags are not X.Y.Z and stay ignored."
      ],
      "managerFilePatterns": [
        "/(^|/)ocx\\.toml$/"
      ],
      "matchStrings": [
        "\"(?<depName>ocx\\.sh/[^:\"]+):(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      "packageNameTemplate": "ghcr.io/{{#if (equals depName 'ocx.sh/grimoire/cli')}}grimoire-rs/grimoire/cli{{else}}{{#if (equals depName 'ocx.sh/ocx/cli')}}ocx-sh/ocx/cli{{else}}ocx-contrib/{{{replace 'ocx.sh/' '' depName}}}{{/if}}{{/if}}"
    },
    {
      "customType": "regex",
      "description": [
        "COPIER_VERSION / ZIZMOR_VERSION vars in conventions' own baseline taskfile, src/ and its generated template/ copy bumped together (D-01); adopted repos receive these pins via copier update, never a direct bump"
      ],
      "managerFilePatterns": [
        "/^(src|template)/taskfiles/baseline\\.taskfile\\.yml$/"
      ],
      "matchStrings": [
        "(?<depName>COPIER|ZIZMOR)_VERSION: \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "{{{lowercase depName}}}",
      "datasourceTemplate": "pypi"
    }
  ],
  "packageRules": [
    {
      "description": [
        "Workflow action bumps use ci(deps)"
      ],
      "matchManagers": [
        "github-actions"
      ],
      "semanticCommitType": "ci",
      "semanticCommitScope": "deps"
    },
    {
      "description": [
        "Group non-major workflow action bumps; the disable rules below win for template-owned refs and files"
      ],
      "matchCategories": [
        "ci"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "github actions (non-major)"
    },
    {
      "description": [
        "Group non-major npm bumps; majors stay separate PRs"
      ],
      "matchCategories": [
        "js"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "npm (non-major)"
    },
    {
      "description": [
        "Group non-major cargo bumps; majors stay separate PRs"
      ],
      "matchCategories": [
        "rust"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "cargo (non-major)"
    },
    {
      "description": [
        "Group non-major python bumps; majors stay separate PRs"
      ],
      "matchCategories": [
        "python"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "python (non-major)"
    },
    {
      "description": [
        "D-02: template workflows pin ocx-sh/conventions via copier (vcs_ref_hash), never Renovate"
      ],
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "ocx-sh/conventions",
        "ocx-sh/conventions/**"
      ],
      "enabled": false
    },
    {
      "description": [
        "Template-owned workflows (verify-basic, verify-deep, claude, deploy-site) move only via copier update; a Renovate pin bump fails baseline:check"
      ],
      "matchManagers": [
        "github-actions"
      ],
      "matchFileNames": [
        ".github/workflows/verify-basic.yml",
        ".github/workflows/verify-deep.yml",
        ".github/workflows/claude.yml",
        ".github/workflows/issues.yml",
        ".github/workflows/deploy-site.yml"
      ],
      "enabled": false
    },
    {
      "description": [
        "Conventions updates (copier) merge themselves once the required basic-gate is green; the 7-day cooldown and weekly window do not apply"
      ],
      "matchManagers": [
        "copier"
      ],
      "automerge": true,
      "automergeType": "pr",
      "minimumReleaseAge": "0 days",
      "schedule": [
        "at any time"
      ]
    },
    {
      "description": [
        "Bump the ocx.toml pin and ocx.lock together (S-007)"
      ],
      "matchManagers": [
        "custom.regex"
      ],
      "postUpgradeTasks": {
        "commands": [
          "ocx lock"
        ],
        "fileFilters": [
          "ocx.lock"
        ],
        "executionMode": "branch"
      },
      "matchDepNames": [
        "ocx.sh/**"
      ]
    },
    {
      "description": [
        "D-12: rules_ocx bumps refresh the module lockfile"
      ],
      "matchManagers": [
        "bazel-module"
      ],
      "matchPackageNames": [
        "rules_ocx"
      ],
      "postUpgradeTasks": {
        "commands": [
          "bazel mod deps"
        ],
        "fileFilters": [
          "MODULE.bazel.lock"
        ],
        "executionMode": "branch"
      }
    },
    {
      "description": [
        "D-07: shared deploy action moves with the site theme"
      ],
      "groupName": "ocx site theme",
      "matchPackageNames": [
        "ocx-sh/website",
        "ocx-sh/website/**",
        "@ocx-sh/theme"
      ]
    }
  ],
  "lockFileMaintenance": {
    "enabled": true
  }
}
